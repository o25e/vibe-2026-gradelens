# ============================================================
# GradeLens 환경변수 설정 파일
# ============================================================
# 이 파일을 복사하여 .env.local 로 저장한 뒤 값을 채워주세요.
#   cp .env.example .env.local   (Mac/Linux)
#   copy .env.example .env.local  (Windows)
# ============================================================

# JWT 서명 비밀키 — 아무 랜덤 문자열이나 입력하세요
JWT_SECRET=gradelens-super-secret-key-change-this-in-production-2026

# Groq API 키 — https://console.groq.com/keys 에서 무료 발급
# 없으면 룰 기반 시뮬레이션 채점으로 자동 대체됩니다
GROQ_API_KEY=gsk_여기에_본인_키_입력
